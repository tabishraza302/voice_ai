# Virtualenv / build artifacts
.venv
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Local configuration — .env.example IS committed, .env is not
.env
.env.*
!.env.example

# Measured artifacts: regenerated by scripts/, not source
data/

# Runtime logs: the host Phoenix writes here, not source
logs/

# The eval harness writes its per-scenario logs into the working
# directory, not into logs/.
*.eval.log

*.db
*.sqlite*

# Evaluation harness and local fixtures
evals/*
!evals/wer_eval.py
*.wav
*.flac
*.mp3

# Model caches
.cache/
/models/

# macOS
.DS_Store

# Keep reviewed first-release contracts with their implementation.
/docs/*
!/docs/first-release/

# Browser test output and credentials
web/playwright.json
web/playwright-report/
web/test-results/
web/playwright/.auth/

.omp
