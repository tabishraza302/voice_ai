# Virtualenv / build artifacts
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Local configuration — .env.example IS committed, .env is not
.env
.env.*
!.env.example

# Measured artifacts: regenerated by scripts/, not source
data/

# Runtime logs: the host Phoenix writes here, not source
logs/

# Evaluation fixtures: downloaded by evals/, not source
evals/fixtures/audio/
evals/fixtures/*.json
*.wav
*.flac
*.mp3

# Model caches
.cache/
models/

# macOS
.DS_Store
