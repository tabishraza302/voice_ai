# Virtualenv / build artifacts
.venv/
__pycache__/
*.py[cod]
*.egg-info/
dist/
build/

# Local configuration — .env.example IS committed, .env is not
.env
.env.*
!.env.example

# Measured artifacts: regenerated by scripts/, not source
data/

# Runtime logs: the host Phoenix writes here, not source
logs/

# The eval harness writes its per-scenario logs into the working
# directory, not into logs/.
*.eval.log

# Evaluation harness and local fixtures
evals/
*.wav
*.flac
*.mp3

# Model caches
.cache/
models/

# macOS
.DS_Store

# Internal planning and local documentation
docs/
