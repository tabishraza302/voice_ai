{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:voice-ai:flow-executable:v1",
  "title": "Conversation flow executable structure v1",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": 1
    },
    "entry_step_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "exit_step_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]{0,63}$"
    },
    "behavior": {
      "$ref": "#/$defs/behavior"
    },
    "welcome": {
      "$ref": "#/$defs/welcome"
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      },
      "minItems": 1,
      "maxItems": 128
    }
  },
  "required": [
    "schema_version",
    "entry_step_id",
    "exit_step_id",
    "steps"
  ],
  "additionalProperties": false,
  "$defs": {
    "condition": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "operator": {
              "const": "eq"
            },
            "field": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "value": {
              "type": [
                "string",
                "integer",
                "boolean"
              ],
              "maxLength": 2048,
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "operator",
            "field",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operator": {
              "const": "ne"
            },
            "field": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "value": {
              "type": [
                "string",
                "integer",
                "boolean"
              ],
              "maxLength": 2048,
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "operator",
            "field",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operator": {
              "const": "gt"
            },
            "field": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "value": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "operator",
            "field",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operator": {
              "const": "gte"
            },
            "field": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "value": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "operator",
            "field",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operator": {
              "const": "lt"
            },
            "field": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "value": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "operator",
            "field",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operator": {
              "const": "lte"
            },
            "field": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "value": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "operator",
            "field",
            "value"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operator": {
              "const": "in"
            },
            "field": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "values": {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "integer",
                  "boolean"
                ],
                "maxLength": 2048,
                "minimum": -9007199254740991,
                "maximum": 9007199254740991
              },
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true
            }
          },
          "required": [
            "operator",
            "field",
            "values"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operator": {
              "const": "is_present"
            },
            "field": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "required": [
            "operator",
            "field"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operator": {
              "const": "is_unknown"
            },
            "field": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "required": [
            "operator",
            "field"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operator": {
              "const": "is_candidate"
            },
            "field": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "required": [
            "operator",
            "field"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operator": {
              "const": "is_refused"
            },
            "field": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "required": [
            "operator",
            "field"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operator": {
              "const": "all_applicable_required_fields_present"
            }
          },
          "required": [
            "operator"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operator": {
              "const": "completed"
            }
          },
          "required": [
            "operator"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "operator": {
              "const": "step_completed"
            },
            "step_id": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            }
          },
          "required": [
            "operator",
            "step_id"
          ],
          "additionalProperties": false
        }
      ]
    },
    "capture": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "required": {
              "type": "boolean",
              "default": true
            },
            "confirmation": {
              "enum": [
                "validated",
                "explicit"
              ],
              "default": "validated"
            },
            "allow_refusal": {
              "type": "boolean",
              "default": true
            },
            "kind": {
              "const": "enum"
            },
            "values": {
              "type": "array",
              "items": {
                "type": "string",
                "minLength": 1,
                "maxLength": 128
              },
              "minItems": 1,
              "maxItems": 64,
              "uniqueItems": true
            }
          },
          "required": [
            "field",
            "kind",
            "values"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "required": {
              "type": "boolean",
              "default": true
            },
            "confirmation": {
              "enum": [
                "validated",
                "explicit"
              ],
              "default": "validated"
            },
            "allow_refusal": {
              "type": "boolean",
              "default": true
            },
            "kind": {
              "const": "positive_integer"
            },
            "maximum": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "field",
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "required": {
              "type": "boolean",
              "default": true
            },
            "confirmation": {
              "enum": [
                "validated",
                "explicit"
              ],
              "default": "validated"
            },
            "allow_refusal": {
              "type": "boolean",
              "default": true
            },
            "kind": {
              "const": "integer"
            },
            "minimum": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            },
            "maximum": {
              "type": "integer",
              "minimum": -9007199254740991,
              "maximum": 9007199254740991
            }
          },
          "required": [
            "field",
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "required": {
              "type": "boolean",
              "default": true
            },
            "confirmation": {
              "enum": [
                "validated",
                "explicit"
              ],
              "default": "validated"
            },
            "allow_refusal": {
              "type": "boolean",
              "default": true
            },
            "kind": {
              "const": "string"
            },
            "max_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 2048,
              "default": 512
            }
          },
          "required": [
            "field",
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "field": {
              "type": "string",
              "pattern": "^[a-z][a-z0-9_]{0,63}$"
            },
            "required": {
              "type": "boolean",
              "default": true
            },
            "confirmation": {
              "enum": [
                "validated",
                "explicit"
              ],
              "default": "validated"
            },
            "allow_refusal": {
              "type": "boolean",
              "default": true
            },
            "kind": {
              "const": "boolean"
            }
          },
          "required": [
            "field",
            "kind"
          ],
          "additionalProperties": false
        }
      ]
    },
    "message": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "en": {
          "type": "string",
          "maxLength": 8192,
          "minLength": 1,
          "pattern": "\\S"
        },
        "hi": {
          "type": "string",
          "maxLength": 8192,
          "minLength": 1,
          "pattern": "\\S"
        }
      },
      "required": [
        "id",
        "en",
        "hi"
      ],
      "additionalProperties": false
    },
    "transition": {
      "type": "object",
      "properties": {
        "when": {
          "$ref": "#/$defs/condition"
        },
        "to": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "required": [
        "when",
        "to"
      ],
      "additionalProperties": false
    },
    "else_transition": {
      "type": "object",
      "properties": {
        "when": {
          "type": "object",
          "properties": {
            "operator": {
              "const": "else"
            }
          },
          "required": [
            "operator"
          ],
          "additionalProperties": false
        },
        "to": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "required": [
        "when",
        "to"
      ],
      "additionalProperties": false
    },
    "behavior": {
      "type": "object",
      "properties": {
        "ordering": {
          "enum": [
            "adaptive",
            "strict"
          ],
          "default": "adaptive"
        },
        "allow_relevant_detours": {
          "type": "boolean",
          "default": true
        },
        "capture_early_information": {
          "type": "boolean",
          "default": true
        },
        "allow_corrections": {
          "type": "boolean",
          "default": true
        },
        "clarification_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5,
          "default": 2
        },
        "allow_opt_out": {
          "type": "boolean",
          "default": true
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "fallback": {
      "type": "object",
      "properties": {
        "action": {
          "const": "clarify",
          "default": "clarify"
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 0,
          "maximum": 5
        },
        "on_exhausted": {
          "enum": [
            "offer_exit",
            "end_partial"
          ],
          "default": "offer_exit"
        }
      },
      "required": [],
      "additionalProperties": false
    },
    "action": {
      "type": "object",
      "properties": {
        "tool_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "input_fields": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "maxProperties": 32
        },
        "result_fields": {
          "type": "object",
          "propertyNames": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "additionalProperties": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]{0,63}$"
          },
          "maxProperties": 32
        }
      },
      "required": [
        "tool_id",
        "input_fields",
        "result_fields"
      ],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "pattern": "\\S"
        },
        "type": {
          "enum": [
            "ask",
            "collect",
            "inform",
            "action",
            "summary",
            "end"
          ]
        },
        "instruction": {
          "type": "string",
          "maxLength": 8192,
          "minLength": 1,
          "pattern": "\\S"
        },
        "priority": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000,
          "default": 100
        },
        "required": {
          "type": "boolean",
          "default": true
        },
        "prerequisites": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/condition"
          },
          "minItems": 0,
          "maxItems": 16
        },
        "captures": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/capture"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "transitions": {
          "type": "array",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/transition"
              },
              {
                "$ref": "#/$defs/else_transition"
              }
            ]
          },
          "minItems": 0,
          "maxItems": 32
        },
        "fallback": {
          "$ref": "#/$defs/fallback"
        },
        "messages": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/message"
          },
          "minItems": 0,
          "maxItems": 32
        },
        "action": {
          "$ref": "#/$defs/action"
        }
      },
      "required": [
        "id",
        "title",
        "type",
        "instruction",
        "prerequisites",
        "captures",
        "transitions"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "ask",
                  "collect"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "captures": {
                "minItems": 1
              },
              "messages": {
                "maxItems": 0
              }
            },
            "not": {
              "required": [
                "action"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "enum": [
                  "inform",
                  "summary",
                  "end"
                ]
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "messages"
            ],
            "properties": {
              "captures": {
                "maxItems": 0
              },
              "messages": {
                "minItems": 1
              }
            },
            "not": {
              "required": [
                "action"
              ]
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "action"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "required": [
              "action"
            ],
            "properties": {
              "messages": {
                "maxItems": 0
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "type": {
                "const": "end"
              }
            },
            "required": [
              "type"
            ]
          },
          "then": {
            "properties": {
              "transitions": {
                "maxItems": 0
              },
              "prerequisites": {
                "maxItems": 0
              },
              "required": {
                "const": false
              }
            }
          }
        }
      ]
    },
    "welcome": {
      "type": "object",
      "properties": {
        "en": {
          "type": "string",
          "maxLength": 8192,
          "minLength": 1,
          "pattern": "\\S"
        },
        "hi": {
          "type": "string",
          "maxLength": 8192,
          "minLength": 1,
          "pattern": "\\S"
        },
        "question_step_id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9_]{0,63}$"
        }
      },
      "required": [
        "en",
        "hi"
      ],
      "additionalProperties": false
    }
  }
}
