# voice-ai configuration (voice-only bare minimum).
# Copy to .env and edit. Field names ARE the environment variable names:
# Settings uses env_prefix="", so `stt_provider` lands in settings.stt_provider.

# --- STT layer ------------------------------------------------------------
# mlx-audio-realtime (default) | mlx-audio | mlx-whisper
stt_provider=mlx-audio-realtime
stt_model=mlx-community/nemotron-3.5-asr-streaming-0.6b
stt_language=auto
stt_base_url=http://localhost:8020/v1
stt_autostart=false

# --- LLM layer ------------------------------------------------------------
# ollama (default) | openai-compatible
llm_provider=ollama
llm_model=qwen3.5:4b
llm_base_url=http://localhost:11434/v1
llm_keep_alive=5m
llm_temperature=0.5
llm_max_tokens=200
llm_api_key=
llm_max_tokens_parameter=max_tokens
llm_reasoning_effort=none

# --- TTS layer ------------------------------------------------------------
# mlx-audio (default) | kokoro (in-process ONNX)
tts_provider=mlx-audio
tts_model=kokoro
tts_voice_en=af_heart
tts_voice_hi=hf_alpha
tts_speed=1.0
tts_base_url=http://localhost:8020

first_chunk_deadline_seconds=0.25

# --- Tracing (Phoenix, on the host) ---------------------------------------
# OTLP/HTTP straight to the host Phoenix server. No collector, no
# PostgreSQL. Phoenix runs with its default (SQLite) backend.
otlp_endpoint=http://localhost:6006/v1/traces
enable_tracing=true

# --- Server ---------------------------------------------------------------
host=localhost
port=7860

# --- Turn detection --------------------------------------------------------
ttfs_p99_latency=1.0
vad_stop_secs=0.8
vad_min_volume=0.6
vad_confidence=0.7

# Agent config file (kept for compatibility; the voice-only agent reads
# its system prompt from Settings, not from a file).
agents_file=webui/agents.json
