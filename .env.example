# voice-ai configuration.
#
# Copy to `.env` and edit. The field names ARE the environment variable
# names: `Settings` uses env_prefix="", so `stt_provider` here lands in
# `settings.stt_provider`.
#
# Every default below is also the built-in default in bot/config.py, so
# the bot runs with no .env at all. This file exists to document the
# knobs and to record the *measured* choices (the LLM tier and the STT
# latency) that a fresh checkout should use.

# --- STT layer ------------------------------------------------------------
# Provider: mlx-audio (NVIDIA Nemotron 3.5 ASR) | mlx-whisper
# The default model scores 6.81 % WER on FLEURS hi_in and 7.91 % on
# en_us; whisper-large-v3-turbo scores 35.56 % and 4.08 %.
stt_provider=mlx-audio
stt_model=mlx-community/nemotron-3.5-asr-streaming-0.6b

# auto | en | hi
# "auto" is Nemotron's language-ID conditioning: it detects the language
# across 40 locales and is the mode that survives code-switching.
stt_language=auto

# The local mlx-audio server.
stt_base_url=http://localhost:8020/v1

# Whether the agent starts the STT server itself. Off by default so the
# server can be restarted independently of the agent; on, the agent
# starts `mlx_audio.server` and stops it when it exits.
stt_autostart=false

# --- LLM layer ------------------------------------------------------------
# Provider: ollama | openai-compatible (llama.cpp, vLLM, LM Studio)
#
# The model is Gemma 3, not Qwen 3, and that is measured: qwen3 is a
# thinking model and Ollama's OpenAI-compatible endpoint does not forward
# `think: false`, so a qwen3 turn spends its whole token budget on
# reasoning and returns an empty answer. Gemma 3 answers in 13 tokens.
#
# The tier the memory rule selects is `gemma3:12b` (see the README's
# measured numbers) — but its 7.3 GB of weights are not on this machine,
# and this link fetches them at about 260 KB/s: seven hours' worth. So
# the configured tier is the largest rung that fits *and* is installed.
# `scripts/voice-ai.sh apply-tier` writes this value, and says which one
# it picked.
llm_provider=ollama
llm_model=gemma3:4b
llm_base_url=http://localhost:11434/v1

# How long Ollama keeps the model resident after a turn. "0" unloads it
# immediately, which with the 12B tier is an 8 GB reload between every
# turn. 5m is Ollama's own default; `scripts/voice-ai.sh warm` pins the
# model for 30m on demand.
llm_keep_alive=5m
llm_temperature=0.7
llm_max_tokens=200

# --- TTS layer ------------------------------------------------------------
# Provider: kokoro | mlx-audio (any mlx-audio TTS model)
#
# Kokoro is the default: in-process ONNX, 340 MB, no server, no API key.
# Its Hindi voices are grade C, though, so the escape hatch is two lines
# away:
#   tts_provider=mlx-audio
#   tts_model=mlx-community/chatterbox-multilingual-v3
#
# `tts_model` is the id the metrics report, not a checkpoint: Kokoro
# runs in-process, so it is just its name.
tts_provider=kokoro
tts_model=kokoro
tts_voice_en=af_heart
tts_voice_hi=hf_alpha
tts_speed=1.0
tts_base_url=http://localhost:8020

# --- Observability --------------------------------------------------------
# The local collector's OTLP receiver. Not 4317: the hear_help stack
# already holds 4317/4318 on this machine.
otlp_endpoint=http://localhost:4319
enable_tracing=true
enable_metrics=true

# --- Server ---------------------------------------------------------------
host=localhost
port=7860

# --- Measured -------------------------------------------------------------
# P99 latency from end-of-speech to final transcript, in seconds.
# Pipecat's built-in default (1.0) is a placeholder for unknown
# hardware; `scripts/voice-ai.sh bench` measures the real value and
# `scripts/apply_tier.py` writes it here.
ttfs_p99_latency=1.796

# Seconds of silence that closes a user turn. Pipecat's default is 0.2 s,
# which cut a real question at its first "uh". 0.8 s buys back those
# splits for up to 0.6 s more end-of-turn latency; lower it to 0.6 if the
# README's latency number regresses.
vad_stop_secs=0.8
