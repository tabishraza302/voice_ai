# Voice Agent Builder — environment reference
#
# Copy this file to .env and fill in real values:
#   cp .env.example .env
# Never commit .env. .env.example is the only env file tracked by git.
#
# Docker Compose reads this file automatically. Local backend runs
# (uv run uvicorn app.main:app) can load it with:
#   set -a; source .env; set +a

# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------
# "production" makes session cookies Secure. Keep "development" for
# http://localhost (including the default Compose setup); switch to
# "production" only when the app is served over HTTPS.
ENVIRONMENT=development

# Exact browser origin of the frontend. State-changing requests must send a
# matching Origin header; a mismatch is rejected with 403.
APP_ORIGIN=http://localhost:3000

# Optional passwordless development buttons. Only enabled when ENVIRONMENT is
# exactly "development" and ALLOW_DEV_LOGIN=true. Each configured credential
# must match an existing account with the corresponding role; this does not
# create accounts or promote users. Keep disabled on shared/untrusted networks.
ALLOW_DEV_LOGIN=false
DEV_USER_EMAIL=dev-user@example.com
DEV_USER_PASSWORD=replace-with-a-long-unique-password

# At least 32 characters. Generate with:
#   openssl rand -base64 48
# Rotating this value signs every user out.
SESSION_SECRET=replace-with-at-least-32-random-characters

# ---------------------------------------------------------------------------
# Administrator bootstrap (used only by: python -m app.bootstrap)
# The password must be at least 12 characters. There is no default admin.
# ---------------------------------------------------------------------------
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-long-unique-password

# ---------------------------------------------------------------------------
# PostgreSQL (Docker Compose)
# Compose substitutes POSTGRES_PASSWORD directly into connection URLs. Use
# only URL-safe characters (for example letters, digits, hyphens, underscores);
# do not percent-encode it here, because PostgreSQL uses the literal value.
# ---------------------------------------------------------------------------
POSTGRES_USER=voice
POSTGRES_PASSWORD=replace-with-a-long-database-password
POSTGRES_DB=voice
POSTGRES_PORT=5432

# Backend connection string. The backend service ignores this host value in
# Compose (Compose supplies postgres:5432); it is the value for local runs.
DATABASE_URL=postgresql+asyncpg://voice:replace-with-a-long-database-password@127.0.0.1:5432/voice

# Disposable database used only by pytest. Compose creates voice_test on the
# first postgres start and overrides this URL with the service hostname.
# Locally, point it at your test PostgreSQL (the suite defaults to
# 127.0.0.1:55432/voice_test when this is unset).
TEST_DATABASE_URL=postgresql+asyncpg://voice:replace-with-a-long-database-password@127.0.0.1:5432/voice_test

# ---------------------------------------------------------------------------
# Service ports exposed on the host
# ---------------------------------------------------------------------------
FRONTEND_PORT=3000
BACKEND_PORT=8000
PHOENIX_PORT=6006

# The frontend's fixed address on the private backend proxy network. Change
# both values together if this subnet conflicts with an existing network.
BACKEND_PROXY_SUBNET=172.29.253.0/24
FRONTEND_PROXY_IP=172.29.253.10

# The Next.js server proxies /api/* to this backend URL. Compose sets it to
# http://backend:8000 automatically; for local `npm run dev` keep 127.0.0.1.
BACKEND_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Phoenix observability (optional but recommended)
# Leave PHOENIX_OTLP_ENDPOINT empty to disable trace export. The owner trace
# view returns 503 with a retry action when Phoenix is not configured.
# Phoenix is bound to 127.0.0.1 in Compose; keep it admin-only.
# ---------------------------------------------------------------------------
PHOENIX_OTLP_ENDPOINT=http://phoenix:6006/v1/traces
PHOENIX_URL=http://phoenix:6006
PHOENIX_PROJECT_NAME=voice-agent

# ---------------------------------------------------------------------------
# Voice provider credentials (backend-only; never expose to browsers)
# All three services are required to publish an agent and place a call.
# ---------------------------------------------------------------------------
DEEPGRAM_API_KEY=
OPENAI_API_KEY=
CARTESIA_API_KEY=
ELEVENLABS_API_KEY=

# OpenAI models an owner may choose. Comma-separated; publishing rejects
# anything not on this allowlist.
VERIFIED_OPENAI_MODELS=gpt-4.1-mini,gpt-4o-mini

# Exact provider/model/voice/language combinations approved on this server.
# One-line JSON. Replace the placeholder voice IDs with IDs verified for your
# account and the languages each voice actually supports (en, hi).
# An agent cannot publish until its selected combination appears here.
VERIFIED_TTS_VOICE_CATALOG={"cartesia":{"sonic-3.6":{"replace-with-cartesia-voice-id":["en"]}},"elevenlabs":{"eleven_flash_v2_5":{"replace-with-elevenlabs-voice-id":["en"]}}}

# ---------------------------------------------------------------------------
# WebRTC ICE / TURN
# STUN is enough on the same machine/LAN. Public calling across strict NATs
# requires a TURN server with REST credentials; without one, calls may fail
# to connect and this deployment must not claim public-network support.
# ---------------------------------------------------------------------------
SMALLWEBRTC_STUN_URLS=stun:stun.l.google.com:19302

# Comma-separated TURN URLs, for example:
# SMALLWEBRTC_TURN_URLS=turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349
SMALLWEBRTC_TURN_URLS=

# Shared secret from the TURN server's REST credential configuration.
# Must be at least 32 bytes. Required only when SMALLWEBRTC_TURN_URLS is set.
SMALLWEBRTC_TURN_SHARED_SECRET=
SMALLWEBRTC_TURN_CREDENTIAL_TTL_SECONDS=600

# Legacy STUN-only JSON form. Prefer SMALLWEBRTC_STUN_URLS above.
# SMALLWEBRTC_ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
