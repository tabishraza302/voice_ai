# voice-ai configuration.
#
# Copy to `.env` and edit. The field names ARE the environment variable
# names: `Settings` uses env_prefix="", so `stt_provider` here lands in
# `settings.stt_provider`.
#
# Every default below is the built-in default in bot/config.py, except
# `ttfs_p99_latency`, which `scripts/voice-ai.sh apply-tier` writes from
# this machine's measurement. The LLM tier is written the same way. The
# bot runs with no .env at all; this file documents the knobs and the
# measured choices a fresh checkout should use.

# --- STT layer ------------------------------------------------------------
# Provider: mlx-audio-realtime (default) | mlx-audio | mlx-whisper
# The default model is Nemotron 3.5 ASR 0.6B; both mlx-audio providers
# run the same checkpoint. Published FLEURS references: 6.81 % WER on
# hi_in and 7.91 % on en_us for Nemotron, 35.56 % and 4.08 % for
# whisper-large-v3-turbo. This repo's own batch-endpoint measurement
# (the transport the eval harness speaks) is 8.56 % en / 7.18 % hi for
# Nemotron and 4.98 % en / 35.92 % hi for Whisper; see the README's STT
# quality table.
# mlx-audio-realtime streams audio over WebSocket (/v1/realtime) with the
# same Nemotron weights: measured TTFS p50 / p99 is 0.89 s / 0.99 s on en and
# 1.00 s / 1.45 s on hi, against batch mlx-audio's 0.94 s / 1.06 s and
# 1.26 s / 1.80 s, measured on this machine, FLEURS corpus, local
# mlx_audio.server. The server takes no language field on /v1/realtime, so
# the realtime mode accepts no mid-session language switch.
stt_provider=mlx-audio-realtime
stt_model=mlx-community/nemotron-3.5-asr-streaming-0.6b

# auto | en | hi
# "auto" is the only value the realtime provider accepts. On the batch
# provider it is Nemotron's language-ID conditioning: it detects the
# language across 40 locales and is the mode that survives code-switching.
# To pin en or hi, switch to stt_provider=mlx-audio.
stt_language=auto

# The local mlx-audio server.
stt_base_url=http://localhost:8020/v1

# Whether the agent owns the mlx-audio server's lifetime. Off by default
# so the server can be restarted independently of the agent; on, the
# agent starts `mlx_audio.server` when it is not already up and stops it
# when it exits. With it off, a layer that needs the server and cannot
# reach it fails at startup with the layer's name.
stt_autostart=false

# Right context (lookahead) for the streaming Nemotron checkpoint, in 80 ms
# frames. Blank keeps the checkpoint's own default: 13 frames = 1.04 s of
# right context and a 1.12 s native chunk. A shorter context makes partial
# text refresh sooner — 6 frames halves the native chunk to 560 ms — at a
# measured streaming WER cost on 40 FLEURS clips: en 9.28 % -> 10.07 %, hi
# 7.95 % -> 8.13 %. A paired bootstrap cannot resolve that cost at this
# sample size (en +0.79 points, 95 % CI -0.56..+2.31; hi +0.17,
# -0.58..+0.93), so this deployment keeps 13. scripts/stt_server.py applies
# the value to each realtime session only; the loaded model, and therefore
# batch transcription, keeps the checkpoint default. It is a deployment
# detail, not an agent setting, so it has no Settings field.
# Reproduce: scripts/voice-ai.sh lookahead-bench --clips 40 --lookaheads 13,6,3,0
stt_lookahead_frames=

# --- LLM layer ------------------------------------------------------------
# Provider: ollama | openai-compatible (llama.cpp, vLLM, LM Studio, or a
# cloud API — a cloud API is the one configuration where the agent reaches
# the internet)
#
# The default model is Qwen3.5 4B (`qwen3.5:4b`). It thinks by default,
# and Ollama's OpenAI-compatible endpoint ignores `think: false`, so the
# reasoning policy below is not optional: without it the model spends the
# whole reply budget thinking and returns no spoken answer.
#
# Alternative options include Gemma 3 (e.g. gemma3:4b or gemma3:12b for
# higher memory tiers).
llm_provider=ollama
llm_model=qwen3.5:4b
llm_base_url=http://localhost:11434/v1

# How long Ollama keeps the model resident after a turn. "0" unloads it
# immediately, which with the 12B tier is an 8 GB reload between every
# turn. 5m is Ollama's own default; `scripts/voice-ai.sh warm` pins the
# model for 30m on demand.
llm_keep_alive=5m
llm_temperature=0.5
llm_max_tokens=200

# The credential for an LLM provider that needs one. The openai-compatible
# provider sends it as a bearer token; a local server ignores it. `OPENAI_KEY`
# is accepted under that name too.
llm_api_key=

# The name the LLM server uses for the reply's length cap. "max_tokens" is
# what llama.cpp, vLLM and LM Studio accept; the gpt-5 family rejects it
# ("use max_completion_tokens instead") and answers nothing at all.
llm_max_tokens_parameter=max_tokens

# Suppress hidden reasoning on Ollama's OpenAI-compatible endpoint, which
# forwards `reasoning_effort` but not `think`. "none" is required for
# Qwen3.5; leave it empty for a server or model that rejects the field.
llm_reasoning_effort=none

# --- TTS layer ------------------------------------------------------------
# Provider: mlx-audio | kokoro (in-process ONNX, no server)
#
# mlx-audio is the default: Kokoro-82M on the Metal GPU, through the
# same local server that serves STT. It is a measured choice — the median
# time to first audio is 0.33 s against 0.79 s for the in-process ONNX
# build (scripts/bench_tts.py, warm, five sentences, this machine), with
# the same voices.
#
# The escape hatch is the multilingual Chatterbox, which clones a voice
# from reference audio and takes a language code instead of a voice pack:
#   tts_model=mlx-community/chatterbox-multilingual-v3
#
# `tts_model` is a placeholder for "whatever model this provider serves
# by default", not a checkpoint: it resolves to
# mlx-community/Kokoro-82M-4bit for mlx-audio.
tts_provider=mlx-audio
tts_model=kokoro
tts_voice_en=af_heart
tts_voice_hi=hf_alpha
tts_speed=1.0
tts_base_url=http://localhost:8020

# How long the first sentence of a reply may take before the bot speaks
# the first clause instead. The bot is silent until the model finishes a
# sentence, and that wait is the largest single part of the time to the
# first sound. Measured on this machine: 0.25 s takes 0.21 s off the
# time to the first sound (scripts/bench_turn.py). Zero turns the cut
# off, which is the behaviour before the deadline existed.
first_chunk_deadline_seconds=0.25

# --- Observability --------------------------------------------------------
# The local collector's OTLP receiver (port 4319 avoids standard 4317
# collisions on developer workstations).
otlp_endpoint=http://localhost:4319
enable_tracing=true
enable_metrics=true

# --- Server ---------------------------------------------------------------
host=localhost
port=7860
web_port=3001

# --- Measured -------------------------------------------------------------
# P99 latency from end-of-speech to final transcript, in seconds.
# Pipecat's built-in default (1.0) is a placeholder for unknown
# hardware; `scripts/voice-ai.sh bench` measures the real value and
# `scripts/apply_tier.py` writes it here.
ttfs_p99_latency=1.796

# Seconds of silence that closes a user turn. Pipecat's default is 0.2 s,
# which cut a real question at its first "uh". 0.8 s buys back those
# splits for up to 0.6 s more end-of-turn latency; lower it to 0.6 if the
# README's latency number regresses.
vad_stop_secs=0.8

# Pipecat's 1.13.0 VAD defaults; tune only from local measurements.
vad_min_volume=0.6
vad_confidence=0.7

# Local agent database. PostgreSQL is the default through docker-compose;
# SQLite is used automatically if PostgreSQL is unavailable.
DATABASE_URL=postgresql+asyncpg://voice_ai:voice_ai@127.0.0.1:5439/voice_ai
SQLITE_DATABASE_URL=sqlite+aiosqlite:///voice_ai.db

# --- Platform API (Control Plane) -----------------------------------------
# The SaaS control plane runs as a separate service on PLATFORM_PORT (default 8000).
# It requires a separate PostgreSQL database and does not use SQLite fallback.

# Required: separate PostgreSQL database for platform control plane.
# Cannot point to the same database as local DATABASE_URL.
PLATFORM_DATABASE_URL=postgresql+asyncpg://voice_ai:voice_ai@127.0.0.1:5439/voice_ai_platform

# Bind host and port for platform API service
PLATFORM_HOST=127.0.0.1
PLATFORM_PORT=8000
PLATFORM_ENV=development

# Web origin for CORS and CSRF enforcement
PLATFORM_WEB_ORIGIN=http://127.0.0.1:3001
# In development, CORS allows precisely PLATFORM_WEB_ORIGIN. Production same-origin requires no cross-origin allowance.
PLATFORM_CORS_ORIGINS=

# Cookie settings
PLATFORM_COOKIE_SECURE=false
PLATFORM_SESSION_COOKIE_NAME=platform_dev_session
PLATFORM_CSRF_COOKIE_NAME=platform_csrf
PLATFORM_CSRF_HEADER_NAME=X-CSRF-Token

# Trusted proxy CIDRs and Allowed Host headers (comma-separated; required for staging/production)
PLATFORM_TRUSTED_PROXY_CIDRS=
PLATFORM_ALLOWED_HOSTS=127.0.0.1,localhost

# Cryptographic keys: required SaaS values in all modes. Must be distinct 32-byte secrets.
# Generate distinct random secrets securely:
#   CSRF & Rate keys: python -c "import secrets; print(secrets.token_urlsafe(32))"
#   MFA key:          python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Do not commit secrets, provide fixed defaults, or reuse keys across purposes.
# PLATFORM_AUTH_CSRF_KEY: 32-byte base64url secret for CSRF HMAC tokens
PLATFORM_AUTH_CSRF_KEY=
# PLATFORM_AUTH_RATE_KEY: 32-byte base64url secret for rate limit key hashing (must differ from CSRF key)
PLATFORM_AUTH_RATE_KEY=
# PLATFORM_AUTH_MFA_KEY: 32-byte Fernet key for encrypting TOTP secrets (must differ from CSRF and rate keys)
PLATFORM_AUTH_MFA_KEY=

# Auth lifetime policy defaults (in seconds, exact contract names)
PLATFORM_AUTH_ANONYMOUS_TTL_SECONDS=600
PLATFORM_AUTH_MFA_TTL_SECONDS=300
PLATFORM_AUTH_SESSION_TTL_SECONDS=43200
PLATFORM_AUTH_IDLE_TTL_SECONDS=1800
PLATFORM_AUTH_IDLE_TOUCH_SECONDS=60
PLATFORM_AUTH_MAX_SESSIONS=5
PLATFORM_AUTH_STEP_UP_SECONDS=300
PLATFORM_AUTH_REGISTER_TTL_SECONDS=86400
PLATFORM_AUTH_RESET_TTL_SECONDS=1800
PLATFORM_AUTH_HASH_CONCURRENCY=2

# Auth rate limits
PLATFORM_AUTH_RATE_GLOBAL_PER_MINUTE=120
PLATFORM_AUTH_RATE_BOOTSTRAP_PER_MINUTE=30
PLATFORM_AUTH_RATE_LOGIN_EMAIL_PER_15_MINUTES=5
PLATFORM_AUTH_RATE_LOGIN_IP_PER_15_MINUTES=30
PLATFORM_AUTH_RATE_MAIL_EMAIL_PER_HOUR=3
PLATFORM_AUTH_RATE_MAIL_IP_PER_HOUR=20
PLATFORM_AUTH_MAIL_RESEND_SECONDS=60
PLATFORM_AUTH_RATE_MFA_SESSION_PER_5_MINUTES=5
PLATFORM_AUTH_RATE_MFA_IP_PER_15_MINUTES=30
PLATFORM_AUTH_RATE_CONFIRM_IP_PER_15_MINUTES=10

# Auth transactional mail configuration
PLATFORM_AUTH_MAIL_MODE=file
PLATFORM_AUTH_MAIL_DIR=data/platform-auth-mail
PLATFORM_AUTH_MAIL_QUEUE_MAX=10000
PLATFORM_AUTH_MAIL_BATCH_SIZE=25
PLATFORM_AUTH_MAIL_LEASE_SECONDS=60
PLATFORM_AUTH_MAIL_ATTEMPTS=5
PLATFORM_AUTH_SMTP_TIMEOUT_SECONDS=10
PLATFORM_AUTH_SMTP_HOST=
PLATFORM_AUTH_SMTP_PORT=587
PLATFORM_AUTH_SMTP_USERNAME=
PLATFORM_AUTH_SMTP_PASSWORD=
PLATFORM_AUTH_MAIL_FROM=
PLATFORM_AUTH_SMTP_TLS_MODE=starttls

# Feature flags (all default to false; defaults cannot enable unsafe capabilities)
PLATFORM_ENABLE_GENERATION=false
PLATFORM_ENABLE_VOICE_TEST=false
PLATFORM_ENABLE_PUBLIC_CALLS=false
PLATFORM_ENABLE_REAL_PAID_CALLS=false
PLATFORM_ENABLE_QA=false
PLATFORM_ENABLE_GATEWAY=false

# Schema version and model catalog
PLATFORM_SCHEMA_VERSION=platform-v1
PLATFORM_CATALOG_PATH=
