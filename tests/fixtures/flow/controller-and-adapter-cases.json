{
  "fixture_version": 1,
  "id": "controller-and-adapter-cases",
  "flow_fixture": "valid-credit-card-en-hi.json",
  "cases": [
    {
      "id": "early_multi_capture",
      "user_text": "I am salaried, earn INR 80000 monthly and want travel rewards.",
      "proposal": {
        "employment_type": "salaried",
        "monthly_income_inr": 80000,
        "card_preference": "travel"
      },
      "assert": {
        "confirmed": [
          "employment_type",
          "monthly_income_inr",
          "card_preference"
        ],
        "completed": [
          "employment",
          "salary",
          "preferences"
        ],
        "next_step": "summary",
        "outcome": "in_progress"
      }
    },
    {
      "id": "correction_invalidation",
      "starting_case": "early_multi_capture",
      "user_text": "Actually I am self-employed.",
      "proposal": {
        "employment_type": "self_employed"
      },
      "assert": {
        "monthly_income_inr": {
          "status": "unknown",
          "applicability": "inapplicable"
        },
        "annual_income_inr": {
          "status": "unknown",
          "applicability": "applicable"
        },
        "card_preference": {
          "status": "confirmed",
          "value": "travel"
        },
        "invalidated_steps": [
          "salary",
          "summary",
          "end"
        ],
        "next_step": "business_income"
      }
    },
    {
      "id": "candidate_not_confirmed",
      "user_text": "Maybe eighty, I am unsure about the period.",
      "proposal": {
        "monthly_income_inr": {
          "status": "candidate",
          "value": 80,
          "reason": "ambiguous"
        }
      },
      "assert": {
        "no_confirmed_capture": true,
        "no_summary_completion": true,
        "routing": "clarify"
      }
    },
    {
      "id": "refusal",
      "starting_step": "salary",
      "confirmed": {
        "employment_type": "salaried"
      },
      "user_text": "I do not want to share my income.",
      "proposal": {
        "monthly_income_inr": {
          "status": "refused"
        }
      },
      "assert": {
        "next_step": "end",
        "outcome": "partial",
        "repeat_income_question": false
      }
    },
    {
      "id": "faq_detour",
      "starting_step": "salary",
      "confirmed": {
        "employment_type": "salaried"
      },
      "user_text": "What is the annual fee?",
      "knowledge": [],
      "assert": {
        "capture_changes": [],
        "resume_step": "salary",
        "may_invent_fee": false,
        "clarification_attempts_increment": 0
      }
    },
    {
      "id": "hindi_same_logic",
      "user_text": "मैं नौकरी करता हूँ, मेरी मासिक आय 80000 रुपये है और मुझे ट्रैवल रिवॉर्ड चाहिए।",
      "proposal": {
        "employment_type": "salaried",
        "monthly_income_inr": 80000,
        "card_preference": "travel"
      },
      "assert_same_business_state_as": "early_multi_capture"
    },
    {
      "id": "else_unknown",
      "conditions": [
        {
          "operator": "eq",
          "field": "employment_type",
          "value": "salaried"
        },
        {
          "operator": "else"
        }
      ],
      "fields": {
        "employment_type": {
          "status": "unknown"
        }
      },
      "assert": {
        "selected_edge": null,
        "routing": "clarify"
      }
    },
    {
      "id": "ordered_unknown_before_true",
      "conditions": [
        {
          "operator": "eq",
          "field": "employment_type",
          "value": "salaried"
        },
        {
          "operator": "is_present",
          "field": "card_preference"
        },
        {
          "operator": "else"
        }
      ],
      "fields": {
        "employment_type": {
          "status": "unknown"
        },
        "card_preference": {
          "status": "confirmed",
          "value": "travel"
        }
      },
      "assert": {
        "selected_edge": 1,
        "reason": "first true; unknown only blocks ELSE"
      }
    },
    {
      "id": "selected_target_blocked",
      "selected_target": "salary",
      "fields": {
        "employment_type": {
          "status": "unknown"
        }
      },
      "assert": {
        "next_step": "employment",
        "try_later_transition": false
      }
    },
    {
      "id": "cancel_before_commit",
      "events": [
        "accept_turn:t1:g1:v1",
        "proposal_begin:g1",
        "accept_turn:t2:g2:v2",
        "proposal_complete:g1"
      ],
      "assert": {
        "commit_g1": false,
        "source_t1_in_history": true
      }
    },
    {
      "id": "cancel_after_commit",
      "events": [
        "accept_turn:t1:g1:v1",
        "proposal_commit:g1:v2",
        "fragment_played:g1:f1",
        "accept_turn:t2:g2:v3",
        "fragment_played:g1:f2"
      ],
      "assert": {
        "committed_captures_retained": true,
        "played_history": [
          "f1"
        ],
        "ignore_late_f2": true
      }
    },
    {
      "id": "tts_text_is_not_played",
      "events": [
        "tts_text:g1:f1",
        "generation_sealed:g1"
      ],
      "assert": {
        "complete_inform": false,
        "history_spoken_fragments": []
      }
    },
    {
      "id": "partial_summary_cancel",
      "required_fragments": [
        "facts",
        "no_guarantee"
      ],
      "events": [
        "played:facts",
        "cancel:g1"
      ],
      "assert": {
        "summary_completed": false,
        "resume_fragments": [
          "no_guarantee"
        ],
        "replay_facts": false
      }
    },
    {
      "id": "stale_and_forged_playback",
      "events": [
        "played:wrong_transport:facts",
        "played:unknown_fragment:facts",
        "played:old_generation:facts"
      ],
      "assert": {
        "state_changes": 0,
        "step_completed": false
      }
    },
    {
      "id": "chat_voice_parity",
      "business_input_case": "early_multi_capture",
      "delivery_modes": [
        "chat_committed",
        "qualified_voice_played"
      ],
      "assert": {
        "identical_capture_state": true,
        "identical_transition_trace": true
      }
    },
    {
      "id": "action_unregistered",
      "tool_id": "transfer_money",
      "assert": {
        "publish_error": "TOOL_UNQUALIFIED",
        "tool_invocations": 0
      }
    },
    {
      "id": "stop_preempts_disclosure",
      "user_text": "Stop now",
      "events": [
        "cancel_current_generation",
        "terminate:aborted"
      ],
      "assert": {
        "wait_for_playback": false,
        "teardown_requests": 1
      }
    },
    {
      "id": "unsupported_playback",
      "capability": "unqualified",
      "assert": {
        "voice_admission_error": "PLAYBACK_UNQUALIFIED",
        "synthesis_is_completion": false,
        "chat_remains_available": true
      }
    }
  ]
}
