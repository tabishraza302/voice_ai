{
  "fixture_version": 1,
  "id": "invalid-authored-cycle",
  "expected": {
    "authoring_valid": true,
    "executable_structure_valid": true,
    "executable_valid": false,
    "error_codes": [
      "GRAPH_CYCLE"
    ]
  },
  "flow": {
    "schema_version": 1,
    "entry_step_id": "employment",
    "exit_step_id": "end",
    "behavior": {
      "ordering": "adaptive",
      "allow_relevant_detours": true,
      "capture_early_information": true,
      "allow_corrections": true,
      "clarification_attempts": 2,
      "allow_opt_out": true
    },
    "welcome": {
      "en": "Hi! I can help you explore credit card options. Are you salaried or self-employed?",
      "hi": "नमस्ते! मैं क्रेडिट कार्ड विकल्प समझने में मदद कर सकता हूँ। आप नौकरी करते हैं या अपना व्यवसाय?",
      "question_step_id": "employment"
    },
    "steps": [
      {
        "id": "employment",
        "title": "Employment type",
        "type": "collect",
        "instruction": "Determine employment type; accept English or Hindi, never infer it from accent.",
        "required": true,
        "priority": 10,
        "prerequisites": [],
        "captures": [
          {
            "field": "employment_type",
            "kind": "enum",
            "values": [
              "salaried",
              "self_employed"
            ]
          }
        ],
        "transitions": [
          {
            "when": {
              "operator": "eq",
              "field": "employment_type",
              "value": "salaried"
            },
            "to": "salary"
          },
          {
            "when": {
              "operator": "eq",
              "field": "employment_type",
              "value": "self_employed"
            },
            "to": "business_income"
          },
          {
            "when": {
              "operator": "is_refused",
              "field": "employment_type"
            },
            "to": "end"
          }
        ]
      },
      {
        "id": "salary",
        "title": "Monthly salary",
        "type": "collect",
        "instruction": "Ask approximate monthly income in INR; ambiguous currency or period needs clarification.",
        "required": true,
        "priority": 20,
        "prerequisites": [
          {
            "operator": "eq",
            "field": "employment_type",
            "value": "salaried"
          }
        ],
        "captures": [
          {
            "field": "monthly_income_inr",
            "kind": "positive_integer"
          }
        ],
        "transitions": [
          {
            "when": {
              "operator": "is_present",
              "field": "monthly_income_inr"
            },
            "to": "preferences"
          },
          {
            "when": {
              "operator": "is_refused",
              "field": "monthly_income_inr"
            },
            "to": "end"
          }
        ]
      },
      {
        "id": "business_income",
        "title": "Annual business income",
        "type": "collect",
        "instruction": "Ask approximate annual business income in INR.",
        "required": true,
        "priority": 20,
        "prerequisites": [
          {
            "operator": "eq",
            "field": "employment_type",
            "value": "self_employed"
          }
        ],
        "captures": [
          {
            "field": "annual_income_inr",
            "kind": "positive_integer"
          }
        ],
        "transitions": [
          {
            "when": {
              "operator": "is_present",
              "field": "annual_income_inr"
            },
            "to": "preferences"
          },
          {
            "when": {
              "operator": "is_refused",
              "field": "annual_income_inr"
            },
            "to": "end"
          }
        ]
      },
      {
        "id": "preferences",
        "title": "Card preference",
        "type": "collect",
        "instruction": "Ask travel, cashback or shopping preference. Answer relevant fee questions only from approved knowledge.",
        "required": true,
        "priority": 30,
        "prerequisites": [],
        "captures": [
          {
            "field": "card_preference",
            "kind": "enum",
            "values": [
              "travel",
              "cashback",
              "shopping"
            ]
          }
        ],
        "transitions": [
          {
            "when": {
              "operator": "is_present",
              "field": "card_preference"
            },
            "to": "employment"
          },
          {
            "when": {
              "operator": "is_refused",
              "field": "card_preference"
            },
            "to": "end"
          }
        ]
      },
      {
        "id": "summary",
        "title": "Summary",
        "type": "summary",
        "instruction": "Summarize confirmed facts without claiming approval.",
        "required": true,
        "priority": 90,
        "prerequisites": [
          {
            "operator": "all_applicable_required_fields_present"
          }
        ],
        "captures": [],
        "transitions": [
          {
            "when": {
              "operator": "completed"
            },
            "to": "end"
          }
        ],
        "messages": [
          {
            "id": "facts",
            "en": "Employment: {{employment_type}}. Monthly INR: {{monthly_income_inr}}. Annual INR: {{annual_income_inr}}. Preference: {{card_preference}}.",
            "hi": "रोज़गार: {{employment_type}}। मासिक रुपये: {{monthly_income_inr}}। वार्षिक रुपये: {{annual_income_inr}}। पसंद: {{card_preference}}।"
          },
          {
            "id": "no_guarantee",
            "en": "This is a preliminary conversation and does not guarantee approval.",
            "hi": "यह प्रारंभिक बातचीत है और मंज़ूरी की गारंटी नहीं है।"
          }
        ]
      },
      {
        "id": "end",
        "title": "Finish",
        "type": "end",
        "instruction": "Close politely. Teardown only after closing delivery or explicit immediate stop.",
        "required": false,
        "priority": 100,
        "prerequisites": [],
        "captures": [],
        "transitions": [],
        "messages": [
          {
            "id": "goodbye",
            "en": "Thank you. Goodbye.",
            "hi": "धन्यवाद। नमस्ते।"
          }
        ]
      }
    ]
  }
}
